#!/bin/sh
set -eu

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/niri"
state_file="$state_dir/touchpad-disabled"
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/niri/hardware-state.kdl"
action="${1:-toggle}"
mkdir -p "$state_dir"

case "$action" in
    toggle) [ -e "$state_file" ] && action="on" || action="off" ;;
    on|off) ;;
    *) exit 2 ;;
esac

if [ "$action" = "on" ]; then
    rm -f "$state_file"
    enabled=true
    message="Touchpad enabled"
    contents='// Runtime hardware state. This file is managed by niri-touchpad-toggle.\ninput {\n    touchpad {\n    }\n}'
else
    : >"$state_file"
    enabled=false
    message="Touchpad disabled"
    contents='// Runtime hardware state. This file is managed by niri-touchpad-toggle.\ninput {\n    touchpad {\n        off\n    }\n}'
fi

tmp_file="${config_file}.tmp"
printf '%b\n' "$contents" >"$tmp_file"
mv -f "$tmp_file" "$config_file"
/usr/bin/niri msg action load-config-file >/dev/null 2>&1 || true
/usr/bin/dms notify "$message" ${enabled:+--icon input-touchpad} >/dev/null 2>&1 || true
