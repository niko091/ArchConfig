#!/usr/bin/env bash

set -uo pipefail

readonly preferred_source="${NIRI_MIRROR_SOURCE:-eDP-1}"
readonly scaling="${NIRI_MIRROR_SCALING:-fit}"
readonly runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly lock_file="$runtime_dir/niri-auto-mirror.lock"

declare -A mirror_pids=()
declare -A mirror_sources=()
check_only=0

log() {
    printf '[%(%F %T)T] %s\n' -1 "$*"
}

notify_user() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send \
        --app-name='Niri Auto Mirror' \
        --icon=video-display \
        --expire-time=2500 \
        'Display mirroring' "$1" >/dev/null 2>&1 || true
}

read_outputs() {
    /usr/bin/niri msg --json outputs 2>/dev/null
}

output_is_active() {
    local wanted=$1
    shift

    local output
    for output in "$@"; do
        [[ $output == "$wanted" ]] && return 0
    done
    return 1
}

choose_source() {
    local -n candidates=$1
    local output

    for output in "${candidates[@]}"; do
        if [[ $output == "$preferred_source" ]]; then
            printf '%s\n' "$output"
            return 0
        fi
    done

    for output in "${candidates[@]}"; do
        if [[ $output =~ ^(eDP|LVDS|DSI)(-|$) ]]; then
            printf '%s\n' "$output"
            return 0
        fi
    done

    (("${#candidates[@]}" > 0)) && printf '%s\n' "${candidates[0]}"
}

stop_mirror() {
    local target=$1
    local pid="${mirror_pids[$target]:-}"

    [[ -n $pid ]] || return 0

    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true

    unset "mirror_pids[$target]"
    unset "mirror_sources[$target]"
    log "stopped mirror on $target"
}

cleanup() {
    local target
    for target in "${!mirror_pids[@]}"; do
        stop_mirror "$target"
    done
}

reconcile() {
    local outputs_json
    if ! outputs_json="$(read_outputs)"; then
        log 'Niri output query failed; will retry'
        return 1
    fi

    if ! /usr/bin/jq -e 'type == "object"' >/dev/null <<<"$outputs_json"; then
        log 'Niri returned an invalid output list; will retry'
        return 1
    fi

    local -a outputs=()
    mapfile -t outputs < <(
        /usr/bin/jq -r \
            'to_entries[] | select(.value.current_mode != null) | .key' \
            <<<"$outputs_json"
    )

    if (("${#outputs[@]}" == 0)); then
        return 1
    fi

    local source
    source="$(choose_source outputs)"

    local target
    for target in "${!mirror_pids[@]}"; do
        if ! output_is_active "$target" "${outputs[@]}" ||
           [[ ${mirror_sources[$target]:-} != "$source" ]] ||
           ! kill -0 "${mirror_pids[$target]}" 2>/dev/null; then
            stop_mirror "$target"
        fi
    done

    if (( check_only )); then
        log "mirror source: $source"
    fi

    local targets_found=0
    local pid
    for target in "${outputs[@]}"; do
        [[ $target == "$source" ]] && continue
        ((targets_found += 1))

        if [[ -n ${mirror_pids[$target]:-} ]] &&
           kill -0 "${mirror_pids[$target]}" 2>/dev/null; then
            continue
        fi

        if (( check_only )); then
            log "would mirror $source onto $target"
            continue
        fi

        log "starting mirror: $source -> $target"
        /usr/bin/wl-mirror \
            --fullscreen-output "$target" \
            --scaling "$scaling" \
            --title "Niri Auto Mirror · $target" \
            "$source" &
        pid=$!

        # Catch immediate protocol/output errors, then let the service supervise it.
        sleep 0.2
        if kill -0 "$pid" 2>/dev/null; then
            mirror_pids["$target"]=$pid
            mirror_sources["$target"]=$source
            notify_user "$source is now mirrored on $target"
        else
            wait "$pid" 2>/dev/null || true
            log "wl-mirror failed to start on $target; will retry"
        fi
    done

    if (( check_only && targets_found == 0 )); then
        log 'no external output is currently connected'
    fi
}

watch_hotplug() {
    local event
    local read_status

    while true; do
        if IFS= read -r -t 15 event; then
            [[ $event == UDEV* && $event == *' (drm)'* ]] || continue

            # Give Niri a moment to finish probing modes after the DRM event.
            sleep 0.6
            reconcile || true
            sleep 1.2
            reconcile || true
        else
            read_status=$?
            if (( read_status == 1 )); then
                return 1
            fi

            # Safety reconciliation in case a driver did not emit a udev event.
            reconcile || true
        fi
    done < <(
        /usr/bin/stdbuf -oL -eL \
            /usr/bin/udevadm monitor --udev --subsystem-match=drm 2>&1
    )
}

case "${1:---watch}" in
    --check)
        check_only=1
        reconcile
        exit $?
        ;;
    --watch)
        ;;
    *)
        printf 'usage: %s [--watch|--check]\n' "$0" >&2
        exit 2
        ;;
esac

exec 9>"$lock_file"
if ! /usr/bin/flock -n 9; then
    log 'another niri-auto-mirror instance is already running'
    exit 0
fi

trap cleanup EXIT
trap 'exit 0' INT TERM HUP

reconcile || true
while ! watch_hotplug; do
    log 'udev monitor stopped; reconnecting'
    sleep 2
    reconcile || true
done
