binds {
    // ASUS Vivobook function row, handled globally by Niri.
    F1 repeat=false allow-when-locked=true { spawn "/usr/bin/dms" "ipc" "call" "audio" "mute"; }
    F2 allow-when-locked=true { spawn "/usr/bin/dms" "ipc" "call" "audio" "decrement" "3"; }
    F3 allow-when-locked=true { spawn "/usr/bin/dms" "ipc" "call" "audio" "increment" "3"; }
    F4 allow-when-locked=true { spawn "/usr/bin/dms" "ipc" "call" "brightness" "decrement" "5" ""; }
    F5 allow-when-locked=true { spawn "/usr/bin/dms" "ipc" "call" "brightness" "increment" "5" ""; }
    F6 repeat=false { spawn-sh "exec \"$HOME/.local/bin/niri-touchpad-toggle\" \"toggle\""; }
    F7 repeat=false allow-when-locked=true { spawn-sh "exec \"$HOME/.local/bin/asus-kbd-backlight-cycle\""; }
    F8 repeat=false { spawn "/usr/bin/dms" "ipc" "call" "settings" "focusOrToggleWith" "displays"; }
    F9 repeat=false allow-when-locked=true { spawn "/usr/bin/dms" "ipc" "call" "audio" "micmute"; }
    F10 repeat=false { spawn-sh "exec \"$HOME/.local/bin/asus-camera-status\""; }
    F11 repeat=false { screenshot; }
    F12 repeat=false { spawn "/usr/bin/dms" "ipc" "call" "settings" "focusOrToggleWith" "about"; }

    // Keep the equivalent XF86 events working when Fn-lock changes keyboard mode.
    XF86TouchpadToggle repeat=false { spawn-sh "exec \"$HOME/.local/bin/niri-touchpad-toggle\" \"toggle\""; }
    XF86TouchpadOn repeat=false { spawn-sh "exec \"$HOME/.local/bin/niri-touchpad-toggle\" \"on\""; }
    XF86TouchpadOff repeat=false { spawn-sh "exec \"$HOME/.local/bin/niri-touchpad-toggle\" \"off\""; }

    // This model has one keyboard-light key: cycle 0 -> 1 -> 2 -> 3.
    XF86KbdBrightnessUp repeat=false allow-when-locked=true { spawn-sh "exec \"$HOME/.local/bin/asus-kbd-backlight-cycle\""; }
    XF86KbdBrightnessDown repeat=false allow-when-locked=true { spawn-sh "exec \"$HOME/.local/bin/asus-kbd-backlight-cycle\""; }

    XF86Display repeat=false { spawn "/usr/bin/dms" "ipc" "call" "settings" "focusOrToggleWith" "displays"; }
    XF86DisplayToggle repeat=false { spawn "/usr/bin/dms" "ipc" "call" "settings" "focusOrToggleWith" "displays"; }

    XF86WebCam repeat=false { spawn-sh "exec \"$HOME/.local/bin/asus-camera-status\""; }
    XF86CameraAccessToggle repeat=false { spawn-sh "exec \"$HOME/.local/bin/asus-camera-status\""; }

    XF86Tools repeat=false { spawn "/usr/bin/dms" "ipc" "call" "settings" "focusOrToggleWith" "about"; }
    XF86Launch2 repeat=false { spawn "/usr/bin/dms" "ipc" "call" "settings" "focusOrToggleWith" "about"; }
}
