[Unit]
Description=Four-finger touchpad pinch for the DMS launcher
Documentation=https://github.com/bulletmark/libinput-gestures
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python -u %h/.local/share/libinput-gestures/libinput-gestures -c %h/.config/libinput-gestures.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
