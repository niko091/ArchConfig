{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "blue",
            "output": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "blue",
                "at": "white",
                "host": "cyan"
            }
        },
        {
            "type": "os",
            "key": "󰣇  OS"
        },
        {
            "type": "kernel",
            "key": "󰒋  Kernel",
            "format": "{release}"
        },
        {
            "type": "wm",
            "key": "  Session"
        },
        {
            "type": "shell",
            "key": "  Shell"
        },
        {
            "type": "uptime",
            "key": "󰅐  Uptime"
        },
        {
            "type": "memory",
            "key": "󰍛  Memory"
        },
        {
            "type": "colors",
            "paddingLeft": 0,
            "symbol": "circle"
        }
    ]
}
