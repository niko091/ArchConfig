// Minimal Niri session used only to host the graphical login screen.
input {
    keyboard {
        numlock
    }

    touchpad {
        tap
    }
}

environment {
    GTK_USE_PORTAL "0"
    GDK_DEBUG "no-portals"
}

output "eDP-1" {
    background-color "#101014"
}

hotkey-overlay {
    skip-at-startup
}

animations {
    off
}

spawn-sh-at-startup "regreet; niri msg action quit --skip-confirmation"
